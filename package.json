{
  "name": "meeting-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Agente que detecta reuniões, transcreve o áudio e gera a ata",
  "author": "Schwaben",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --win",
    "test": "vitest run",
    "icon": "electron scripts/make-icon.cjs"
  },
  "build": {
    "appId": "br.com.schwaben.meetingagent",
    "productName": "Meeting Agent",
    "files": [
      "out/**"
    ],
    "extraResources": [
      { "from": "resources/icon.png", "to": "icon.png" }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "clsx": "^2.1.1",
    "docx": "^9.14.0",
    "framer-motion": "^14.7.1",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
